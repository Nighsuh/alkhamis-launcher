<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.gathin.transfer.ScanOverlay
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFE6C57A"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="96dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/scan_hint"
        android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

    <TextView
        android:id="@+id/zoomReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101419"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFE6C57A"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/zoom1"
                style="@style/GoldButton"
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:layout_marginTop="0dp"
                android:text="1x" />

            <Button
                android:id="@+id/zoom2"
                style="@style/GoldButton"
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:text="2x" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/zoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="1"
            android:valueFrom="1"
            android:valueTo="4"
            app:haloColor="#55E6C57A"
            app:thumbColor="#FFE6C57A"
            app:trackColorActive="#FFE6C57A"
            app:trackColorInactive="#FF3A4450" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/torch"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/torch" />

            <Button
                android:id="@+id/gallery"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/gallery" />
        </LinearLayout>

        <Button
            android:id="@+id/allow"
            style="@style/GoldButton"
            android:text="@string/scan_allow"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
