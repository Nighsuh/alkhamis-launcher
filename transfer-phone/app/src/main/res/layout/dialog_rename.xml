<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A2129"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename"
        android:textColor="#FFE6C57A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/renameField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rename_field_bg"
        android:hint="@string/rename_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="30"
        android:minHeight="56dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textAlignment="center"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#FFACB8C1"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/renameCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFACB8C1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/renameError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename_invalid"
        android:textColor="#FFFFB4AB"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/renameCancel"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/cancel"
            android:textSize="16sp" />

        <Button
            android:id="@+id/renameSave"
            style="@style/GoldButton"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/save"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
