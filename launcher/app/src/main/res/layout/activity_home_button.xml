<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_button_name"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/homeButtonState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFE6C57A"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_button_steps"
            android:textColor="#FFD5DDE4"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/homeButtonOpen"
            style="@style/SettingsRow"
            android:layout_marginTop="16dp"
            android:text="@string/home_button_open_settings" />

        <TextView
            android:id="@+id/homeButtonOff"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/home_button_off" />
    </LinearLayout>
</ScrollView>
