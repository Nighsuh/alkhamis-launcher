<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/transferRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="18dp"
        android:background="@drawable/transfer_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/file_transfer"
                android:src="@drawable/ic_transfer"
                android:tint="#FFE6C57A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@string/font_medium"
                android:text="@string/file_transfer"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/transfer_qr_pad"
            android:padding="8dp">

            <ImageView
                android:id="@+id/transferQr"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:contentDescription="@string/file_transfer" />
        </FrameLayout>

        <TextView
            android:id="@+id/transferUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textDirection="ltr"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/transferPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:textColor="#FFE6C57A"
            android:textDirection="ltr"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/transferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/transferBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/settings_choice_bg"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@string/font_medium"
                android:text="@string/file_transfer_background"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/transferSwitch"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/transfer_switch_off"
                android:fontFamily="@string/font_medium"
                android:gravity="center"
                android:textColor="#FF101419"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/transferNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/transfer_card"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/transferFileScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:fillViewport="true"
            android:focusable="false"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/transferFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/transferEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="32dp"
            android:text="@string/file_transfer_empty_help"
            android:textColor="#FFACB8C1"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
