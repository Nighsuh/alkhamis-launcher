<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="#FF1A2129"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_transfer_rename"
        android:textColor="#FFE6C57A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/renameField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rename_field_bg"
        android:hint="@string/file_transfer_rename_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="30"
        android:minHeight="56dp"
        android:nextFocusDown="@+id/renameSave"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#FFACB8C1"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/renameCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rename_cancel_bg"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:nextFocusRight="@+id/renameSave"
            android:nextFocusUp="@+id/renameField"
            android:text="@string/file_transfer_rename_cancel"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/renameSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/rename_save_bg"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:nextFocusLeft="@+id/renameCancel"
            android:nextFocusUp="@+id/renameField"
            android:text="@string/file_transfer_rename_save"
            android:textColor="#FF101419"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
