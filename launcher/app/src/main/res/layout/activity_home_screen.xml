<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF152033"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="36dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_screen_label"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/homeFmtNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_screen_fmt"
            android:textColor="#FFE6C57A"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/homeAlkhamis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/home_option_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeAlkhamisTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_screen_alkhamis_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeAlkhamisSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_screen_alkhamis_sub"
                    android:textColor="#FFACB8C1"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeAlkhamisCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:text="✓"
                android:textColor="#FF15202B"
                android:textSize="22sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/home_option_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeOriginalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_screen_original"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeOriginalSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_screen_original_sub"
                    android:textColor="#FFACB8C1"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeOriginalCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:text="✓"
                android:textColor="#FF15202B"
                android:textSize="22sp"
                android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/home_screen_note"
            android:textColor="#FFACB8C1"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
