<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:clipToPadding="false"
    android:fadingEdgeLength="36dp"
    android:fillViewport="true"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_screen_title"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/dimLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FFACB8C1"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="90"
            android:progress="45" />

        <TextView
            android:id="@+id/useShrine"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/wallpaper_shrine" />

        <TextView
            android:id="@+id/pickDevice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/wallpaper_pick" />

        <TextView
            android:id="@+id/browse"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/wallpaper_browse" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/settings_choice_bg"
            android:hint="@string/wallpaper_url_hint"
            android:inputType="textUri"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF8B98A3"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/download"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/wallpaper_download" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reset"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/wallpaper_reset" />
    </LinearLayout>
</ScrollView>
