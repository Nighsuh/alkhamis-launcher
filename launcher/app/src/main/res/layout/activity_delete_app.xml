<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:clipToPadding="false"
    android:fadingEdgeLength="36dp"
    android:fillViewport="true"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFC7C2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFACB8C1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/connect"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/adb_connect" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/adb_pair_heading"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/settings_choice_bg"
            android:hint="@string/adb_pair_code"
            android:inputType="number"
            android:maxLength="6"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF8B98A3"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/pairPort"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_choice_bg"
            android:hint="@string/adb_pair_port"
            android:inputType="number"
            android:maxLength="5"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF8B98A3"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/debugPort"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_choice_bg"
            android:hint="@string/adb_debug_port"
            android:inputType="number"
            android:maxLength="5"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF8B98A3"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pair"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/adb_pair" />

        <TextView
            android:id="@+id/confirm"
            style="@style/SettingsRow"
            android:layout_marginTop="22dp"
            android:text="@string/delete_completely" />

        <TextView
            android:id="@+id/disable"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/delete_disable"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
